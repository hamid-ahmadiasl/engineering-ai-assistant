# Copy to .env and fill in the keys you have. Never commit .env.
# The app runs without a key: answers are then extractive and still cited.
# With a key, the same evidence pack is written out by the configured LLM.

# ---------------------------------------------------------------------------
# LLM presets (OpenAI-compatible). Groq is the default.
# Set LLM_PRESET and the matching key. LLM_BASE_URL / LLM_MODEL / LLM_API_KEY
# override the preset when you set them.
# ---------------------------------------------------------------------------
LLM_PRESET=groq
LLM_PROVIDER=auto
# auto = call the API when a key is present, otherwise cited extractive answers
# none = never call an LLM

# Groq (default) — https://console.groq.com/keys
# Free tier key goes in the environment or a Hugging Face Space secret.
GROQ_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Google Gemini, OpenAI-compatible endpoint
# https://ai.google.dev/gemini-api/docs/openai
# GEMINI_API_KEY=
# LLM_PRESET=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# OpenAI
# OPENAI_API_KEY=
# LLM_PRESET=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Azure OpenAI (OpenAI-compatible base URL of your deployment)
# LLM_PRESET=custom
# LLM_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Ollama or any local OpenAI-compatible server
# LLM_PRESET=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# Optional explicit overrides (win over the preset)
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# ---------------------------------------------------------------------------
# Embeddings. fastembed runs on CPU (BAAI/bge-small-en-v1.5, 384 dims).
# hash is a deterministic offline fallback used by tests. No key required.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
# Multilingual so a Persian question can sit near the English source text.
# intfloat/multilingual-e5-small is a small CPU model (384 dimensions).
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# EMBEDDING_PROVIDER=hash

# How Persian questions are turned into English search text.
# both     = glossary plus an LLM rewrite when a key is set (default)
# glossary = deterministic engineering glossary only
# llm      = model rewrite, glossary if the call fails
# off      = rely on the multilingual embedding alone
QUERY_TRANSLATION=both

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-string
DATA_DIR=./data
# Leave DATABASE_URL empty for SQLite at $DATA_DIR/app.db.
# Hugging Face free disk is ephemeral. For a public demo set a free hosted
# Postgres, for example Neon or Supabase:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
HOST=0.0.0.0
PORT=7860
APP_BASE_URL=http://localhost:7860
SEED_ON_STARTUP=true

# Admin account created on startup when both are set and the email is new.
# Password is stored only as a bcrypt hash. Restart does not overwrite it.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Public demo guard. The Docker image defaults DEMO_MODE=true.
# docker-compose sets false so a local stack can upload and register.
# ---------------------------------------------------------------------------
DEMO_MODE=false
DEMO_ALLOW_REGISTRATION=false
DEMO_TRIAL_ENABLED=true
DEMO_CHAT_PER_HOUR=30
TRIAL_CREDITS=5
MAX_TRIALS_PER_IP_PER_DAY=3

# ---------------------------------------------------------------------------
# Plans and credits. One chat query costs CREDIT_COST_PER_QUERY.
# Balance resets to the plan allowance when the monthly period ends.
# ---------------------------------------------------------------------------
CREDIT_COST_PER_QUERY=1
FREE_MONTHLY_CREDITS=40
PRO_MONTHLY_CREDITS=400
ADMIN_MONTHLY_CREDITS=10000
FREE_UPLOADS_PER_DAY=8
PRO_UPLOADS_PER_DAY=40
MAX_UPLOAD_MB_FREE=8
MAX_UPLOAD_MB_PRO=25

# Optional OCR for scanned pages and images. Needs the tesseract binary.
OCR_ENABLED=false

# ---------------------------------------------------------------------------
# Stripe is off unless every value below is set. Use test keys first.
# Dashboard: Product + recurring Price, then a webhook endpoint.
# Events: checkout.session.completed, invoice.paid, customer.subscription.deleted
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_SUCCESS_URL=http://localhost:7860/?billing=success
# STRIPE_CANCEL_URL=http://localhost:7860/?billing=cancel
